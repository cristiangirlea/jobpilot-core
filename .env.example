# Required
# DATABASE_URL, JWT_SECRET, GOOGLE_CLIENT_SECRET and SMTP_PASSWORD also accept NAME_FILE (a path whose content is the value).
JWT_SECRET=replace-with-a-long-random-value

# Who may create an account: invite (the API's default; an admin creates
# single-use codes under Settings), open, or closed. The Compose stack
# defaults to open for local development. Before sharing a server: register
# your own account while it is open, name it in ADMIN_EMAILS, then set
# REGISTRATION=invite and restart.
# REGISTRATION=invite
# Accounts that may create invites, comma-separated. Set, it also makes every
# other account a member: no discovery and no AI provider for them, their own
# data only.
# ADMIN_EMAILS=you@example.com
# Agent tokens (MCP) for members: off (default), read or write.
# USER_AGENT_TOKENS=off
# A header the proxy in front of the API sets to the caller's address, for the
# login and sign-up rate limits; CF-Connecting-IP behind a Cloudflare Tunnel.
# Leave empty when nothing sits in front: a header the client can set itself
# (X-Forwarded-For) would let it pick its own address.
CLIENT_IP_HEADER=

# Optional "Sign in with Google". Leave GOOGLE_CLIENT_ID empty to keep email
# and password only. Create an OAuth client (type "Web application") in Google
# Cloud Console and add the redirect URL below as an authorized redirect URI;
# it is the API's address, for Compose http://localhost:8080/api/auth/google/callback.
# An existing account links Google under Settings before signing in with it.
# GOOGLE_ALLOW_SIGNUP=true also lets a Google account create a JobPilot account
# when no account has its email and REGISTRATION=open.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
GOOGLE_ALLOW_SIGNUP=

# Email for verifying addresses and resetting passwords, through an SMTP relay
# over TLS (STARTTLS on 587, or 465). Unset, no email is sent and accounts do
# not have to verify. With Brevo's
# relay: SMTP_HOST=smtp-relay.brevo.com, SMTP_USERNAME is the SMTP login it
# shows, SMTP_PASSWORD an SMTP key, and MAIL_FROM a sender it has verified.
# Links in the emails point at FRONTEND_URL.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=JobPilot <jobs@example.com>

# Optional AI adapter. Leave LLM_PROVIDER=none to run fully deterministically;
# every feature has a deterministic path and none of them require a provider.
#
#   none    no AI at all (default)
#   cli     run an installed agent CLI as a subprocess, billed against an
#           existing subscription rather than per token
#   ollama  a local Ollama server
LLM_PROVIDER=none

# For LLM_PROVIDER=cli, pick one:
#   Claude Code:  LLM_CLI_COMMAND=claude   LLM_CLI_ARGS=-p --output-format text --tools "" --strict-mcp-config --no-session-persistence
#   Codex:        LLM_CLI_COMMAND=codex    LLM_CLI_ARGS=exec --skip-git-repo-check -
# The prompt is written to stdin unless an argument contains {{prompt}}; quote an
# argument to keep spaces or pass an empty one. The claude arguments above turn
# every tool off, so the CLI only writes text. Each call runs in a new empty folder
# of its own, created under LLM_CLI_DIR (an existing, writable folder) or the
# system's temporary folder when it is empty, and gets only the environment it
# needs (PATH, HOME, CLAUDE_*, ANTHROPIC_*, CODEX_*, OPENAI_* and a few more).
LLM_CLI_COMMAND=
LLM_CLI_ARGS=
LLM_CLI_DIR=
# In Compose the CLIs are in the ai image: set API_IMAGE_TARGET=ai. Claude Code
# signs in with a token from `claude setup-token` (your subscription), kept here
# in .env, never in the image or the repository.
API_IMAGE_TARGET=runtime
CLAUDE_CODE_OAUTH_TOKEN=

# For LLM_PROVIDER=ollama
LLM_OLLAMA_URL=http://localhost:11434

# Applies to any provider. LLM_MODEL is optional for the CLI provider.
LLM_MODEL=
LLM_TIMEOUT_SECONDS=90
LLM_CALLS_PER_HOUR=120

# Posting extraction is off unless a model name is set.
# EXTRACTION_MODEL=example-model
# Score with current extractions alongside the rules when set to shadow.
# EXTRACTION_SCORING=off

# Greenhouse board API origin. Leave unset for the public service. Point it at
# a fake, for example http://host.docker.internal:18999, to run the MCP
# end-to-end flow's employer-form section against a local stack.
# ATS_GREENHOUSE_URL=https://boards-api.greenhouse.io
# The same for Ashby's job pages and for Recruitee careers sites (unset, each
# site's own host); the end-to-end flow fakes both on the same port.
# ATS_ASHBY_URL=https://jobs.ashbyhq.com
# ATS_RECRUITEE_URL=

# Send approved applications through the employer's own form (Greenhouse
# only; a form with a CAPTCHA comes back to you unsent). Off unless set to
# true, so approvals given before sending existed never go out on upgrade.
# An approval waits OUTBOX_SEND_DELAY_SECONDS before it goes, so it can
# still be withdrawn.
# OUTBOX_SENDER_ENABLED=false
# OUTBOX_SEND_DELAY_SECONDS=120
