# Required
JWT_SECRET=replace-with-a-long-random-value

# Optional AI adapter. Leave LLM_PROVIDER=none to run fully deterministically;
# every feature has a deterministic path and none of them require a provider.
#
#   none    no AI at all (default)
#   cli     run an installed agent CLI as a subprocess, billed against an
#           existing subscription rather than per token
#   ollama  a local Ollama server
LLM_PROVIDER=none

# For LLM_PROVIDER=cli, pick one:
#   Claude Code:  LLM_CLI_COMMAND=claude   LLM_CLI_ARGS=-p --output-format text
#   Codex:        LLM_CLI_COMMAND=codex    LLM_CLI_ARGS=exec {{prompt}}
# The prompt is written to stdin unless an argument contains {{prompt}}.
LLM_CLI_COMMAND=
LLM_CLI_ARGS=

# For LLM_PROVIDER=ollama
LLM_OLLAMA_URL=http://localhost:11434

# Applies to any provider. LLM_MODEL is optional for the CLI provider.
LLM_MODEL=
LLM_TIMEOUT_SECONDS=90
LLM_CALLS_PER_HOUR=120
