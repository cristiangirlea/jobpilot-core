{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(gofmt -l *)",
      "Bash(gofmt -d *)",
      "Bash(go vet *)",
      "Bash(go test *)",
      "Bash(go build *)",
      "Bash(go mod tidy -diff *)",
      "Bash(go mod download *)",
      "Bash(go list *)",
      "Bash(go env *)",
      "Bash(go version *)",
      "Bash(npm ci *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run lint *)",
      "Bash(npm run build *)",
      "Bash(make test *)",
      "Bash(make mcp *)",
      "Bash(docker build *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose config *)",
      "Bash(kustomize build *)",
      "Bash(kubeconform *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git grep *)",
      "Bash(git blame *)",
      "Bash(git branch *)",
      "Bash(git worktree list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)"
    ],
    "ask": [
      "Bash(gh pr create *)",
      "Bash(gh issue create *)",
      "Bash(git tag *)",
      "Bash(make dev *)",
      "Bash(make migrate *)",
      "Bash(make seed *)",
      "Bash(make smoke *)",
      "Bash(make smoke-live *)",
      "Bash(make smoke-regression *)",
      "Bash(make smoke-mcp *)",
      "Bash(docker compose up *)",
      "Bash(docker compose run *)",
      "Bash(docker compose exec *)",
      "Bash(docker compose logs *)",
      "Bash(psql *)",
      "Bash(pwsh -File scripts/agent-token.ps1 *)",
      "Bash(powershell -File scripts/agent-token.ps1 *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(gh workflow run *)",
      "Bash(gh run rerun *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin master *)",
      "Bash(docker push *)",
      "Bash(docker compose down -v *)",
      "Bash(docker volume rm *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl edit *)",
      "Bash(kubectl patch *)",
      "Bash(kubectl set *)",
      "Bash(tofu apply *)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./.mcp.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gofmt-check.sh",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
